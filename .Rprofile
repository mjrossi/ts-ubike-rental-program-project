source("renv/activate.R")

# R Debugger (F5 / Ctrl+F5). Only vscDebugger reads these.
options(
  # nolint start: line_length_linter
  vsc.groupAttributes = TRUE, # one attributes node instead of names/row.names/class/sf_column each listed separately
  vsc.convertFactorEntries = TRUE, # factor values shown as plain labels, not one-element factors
  vsc.defaultPrintEval = 1 # print top-level results like the console does; the default 0 drops them, so plots never draw
  #nolint end: line_length_linter
)
