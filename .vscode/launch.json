{
  // No "Debug R-Package": DESCRIPTION is only for renv
  "version": "0.2.0",
  "configurations": [
    {
      "type": "R-Debugger",
      "request": "launch",
      "name": "Debug R-File",
      "debugMode": "file",
      "workingDirectory": "${workspaceFolder}",
      "file": "${file}",
      "allowGlobalDebugging": true
    },
    {
      "type": "R-Debugger",
      "request": "launch",
      "name": "Launch R-Workspace",
      "debugMode": "workspace",
      "workingDirectory": "${workspaceFolder}",
      "allowGlobalDebugging": true
    }
  ]
}
